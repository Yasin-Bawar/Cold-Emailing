# Copy to .env for local development (never commit .env). On Railway, set these as service variables instead.

# Supabase > Project Settings > Database > Connection string (URI). The session pooler (port 5432) works well.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Any long random string (e.g. `openssl rand -base64 32`). Encrypts stored Gmail App Passwords and Resend keys.
# Keep it safe: if it changes, connected accounts must be re-added.
ENCRYPTION_KEY=

# Password for the dashboard login.
ADMIN_PASSWORD=

# Public URL of the API service (used in unsubscribe links). Locally: http://localhost:8080
PUBLIC_URL=http://localhost:8080

# Supabase > Project Settings > API. The service_role key is server-only: never put it in the browser or in chat.
# Leave both empty locally to store images on disk in STORAGE_DIR instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # or SUPABASE_SECRET_KEY (the sb_secret_... key); either name works
STORAGE_BUCKET=campaign-assets

# "Connect Gmail" (Google sign-in, sends through the Gmail API over HTTPS). Needed on Railway Trial/Hobby, which block
# SMTP. Google Cloud > Google Auth Platform > Clients > Web application; redirect URI: <PUBLIC_URL>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Railway sets PORT itself. ROLE=worker on the worker service; the API service needs nothing (defaults to api).
# PORT=8080
# ROLE=api

# Optional
# JWT_SECRET=            defaults to a value derived from ENCRYPTION_KEY
# SEND_TICK_SECONDS=120  how often the worker tries to send
# IMAP_TICK_SECONDS=600  how often the worker checks Gmail inboxes for replies and bounces
# AUTO_MIGRATE=false     the API applies database migrations on start unless this is false
