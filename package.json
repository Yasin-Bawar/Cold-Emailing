{
  "name": "mavan-outreach",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2"
  },
  "scripts": {
    "dev:api": "node init && pnpm --filter server dev:api",
    "dev:worker": "node init && pnpm --filter server dev:worker",
    "dev:web": "node init && pnpm --filter web dev",
    "build": "node init && pnpm --filter web build",
    "start": "node init && pnpm --filter server start",
    "start:api": "node init && pnpm --filter server start:api",
    "start:worker": "node init && pnpm --filter server start:worker",
    "migrate": "pnpm --filter server migrate",
    "token:create": "pnpm --filter server token:create",
    "import:outreach": "pnpm --filter server import:outreach",
    "typecheck": "pnpm --filter server typecheck && pnpm --filter web typecheck",
    "test": "pnpm --filter server test"
  },
  "engines": {
    "node": ">=22"
  }
}
